{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "infinite-canvas",
    "version": "0.18.0",
    "identifier": "com.infinite-canvas.desktop",
    "build": {
        "frontendDist": "../../web/dist",
        "beforeBuildCommand": "bun run --cwd ../web build:desktop",
        "beforeDevCommand": "bun run --cwd ../web dev",
        "devUrl": "http://localhost:3000"
    },
    "app": {
        "windows": [
            {
                "title": "无限画布",
                "width": 1440,
                "height": 900,
                "minWidth": 1024,
                "minHeight": 640,
                "resizable": true,
                "visible": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
        "windows": {
            "webviewInstallMode": {
                "type": "downloadBootstrapper",
                "silent": true
            }
        }
    }
}
